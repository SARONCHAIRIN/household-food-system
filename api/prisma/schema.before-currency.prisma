generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               BigInt              @id @default(autoincrement())
  name             String              @db.VarChar(255)
  username         String              @db.VarChar(255)
  email            String              @db.VarChar(255)
  passwordHash     String              @map("password_hash") @db.VarChar(255)
  role             String              @default("MEMBER") @db.VarChar(20)
  status           String              @default("ACTIVE") @db.VarChar(20)
  joinedAt         DateTime?           @map("joined_at") @db.Date
  inactiveAt       DateTime?           @map("inactive_at") @db.Date
  createdAt        DateTime?           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  refresh_token    String?
  BILL_SETTLEMENTS BILL_SETTLEMENTS[]
  dailyCosts       DailyFoodCost[]
  mealStatuses     MealStatus[]
  weekSummaries    MemberWeekSummary[]
  auditLogs        AuditLog[]
  memberDeposits   MemberDeposit[]

  @@map("USERS")
}

model DailyFoodCost {
  id                      BigInt    @id @default(autoincrement())
  date                    DateTime  @db.Date
  foodPrice               Decimal?  @map("food_price") @db.Decimal(10, 2)
  ingredientPrice         Decimal?  @map("ingredient_price") @db.Decimal(10, 2)
  eatCount                Int?      @map("eat_count")
  totalMemberCount        Int?      @map("total_member_count")
  costFoodPerPerson       Decimal?  @map("cost_food_per_person") @db.Decimal(10, 2)
  costIngredientPerPerson Decimal?  @map("cost_ingredient_per_person") @db.Decimal(10, 2)
  calculationStatus       String    @map("calculation_status") @db.VarChar(20)
  confirmedAt             DateTime? @map("confirmed_at") @db.Timestamp(6)
  createdBy               BigInt?   @map("created_by")
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  creator                 User?     @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "daily_food_cost_created_by_fk")

  @@map("DAILY_FOOD_COST")
}

model MealStatus {
  id               BigInt    @id @default(autoincrement())
  memberId         BigInt    @map("member_id")
  date             DateTime  @db.Date
  status           String    @db.VarChar(20)
  confirmationType String    @map("confirmation_type") @db.VarChar(20)
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamp(6)
  costFood         Decimal?  @map("cost_food") @db.Decimal(10, 2)
  costIngredient   Decimal?  @map("cost_ingredient") @db.Decimal(10, 2)
  costTotal        Decimal?  @map("cost_total") @db.Decimal(10, 2)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  member           User      @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "meal_status_member_fk")

  @@unique([memberId, date], map: "meal_status_member_date_unique")
  @@map("MEAL_STATUS")
}

model MemberWeekSummary {
  id                  BigInt    @id @default(autoincrement())
  memberId            BigInt    @map("member_id")
  weekStart           DateTime  @map("week_start") @db.Date
  weekEnd             DateTime  @map("week_end") @db.Date
  eatDays             Int?      @map("eat_days")
  dontEatDays         Int?      @map("dont_eat_days")
  totalFoodCost       Decimal?  @map("total_food_cost") @db.Decimal(10, 2)
  totalIngredientCost Decimal?  @map("total_ingredient_cost") @db.Decimal(10, 2)
  totalCost           Decimal?  @map("total_cost") @db.Decimal(10, 2)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  member              User      @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "member_week_summary_member_fk")

  @@map("MEMBER_WEEK_SUMMARY")
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  action     String    @db.VarChar(255)
  entityType String?   @map("entity_type") @db.VarChar(100)
  entityId   BigInt?   @map("entity_id")
  oldValue   String?   @map("old_value")
  newValue   String?   @map("new_value")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_log_user_fk")

  @@map("audit_log")
}

model MemberDeposit {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  userId    BigInt    @map("user_id")
  amount    Decimal   @db.Decimal(10, 2)
  type      String    @db.VarChar(50)
  note      String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_deposits_user")

  @@index([userId], map: "idx_member_deposits_user_id")
  @@map("member_deposits")
}

model BILL_SETTLEMENTS {
  id                    BigInt    @id @default(autoincrement())
  start_date            DateTime  @db.Date
  end_date              DateTime  @db.Date
  settled_by            BigInt?
  total_food_cost       Decimal?  @db.Decimal(10, 2)
  total_ingredient_cost Decimal?  @db.Decimal(10, 2)
  total_due_all         Decimal?  @db.Decimal(10, 2)
  results               Json
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  USERS                 User?     @relation(fields: [settled_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bill_settlements_settled_by_fk")

  @@index([created_at(sort: Desc)], map: "idx_bill_settlements_created_at")
}
